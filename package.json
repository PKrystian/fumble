{
  "name": "fumble",
  "version": "1.2.72",
  "private": true,
  "type": "module",
  "description": "Fumble - a free, client-side D&D 2024 (5.5e) toolkit and Obsidian-powered campaign wiki.",
  "license": "MIT",
  "author": "Krystian Pińczak",
  "homepage": "https://fumble.krystianpinczak.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PKrystian/Fumble.git"
  },
  "bugs": {
    "url": "https://github.com/PKrystian/Fumble/issues"
  },
  "keywords": [
    "dnd",
    "dnd5e",
    "dnd-2024",
    "character-sheet",
    "dice-roller",
    "campaign-wiki",
    "react",
    "typescript"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:coverage": "cross-env E2E_COVERAGE=1 vite",
    "build": "tsc -b && vite build",
    "build:pages": "cross-env VITE_COMPRESSED_BOOK_DATA=true npm run build && tsx scripts/seo/compressBookData.ts",
    "postbuild": "tsx scripts/seo/sitemap.ts && tsx scripts/quality/validateRelease.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "audit-ci --high --allowlist GHSA-qwww-vcr4-c8h2",
    "verify:ci": "npm run security:audit && npm run lint && npm run format:check && npm sbom --sbom-format cyclonedx > fumble-sbom.cdx.json && npm run typecheck && cross-env CI=1 npm run test:coverage:all && npm run build",
    "release:validate": "tsx scripts/quality/validateRelease.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "cross-env E2E_COVERAGE=1 playwright test",
    "test:coverage:all": "tsx scripts/coverage/clean.ts && npm run test:coverage && npm run test:e2e:coverage && npm run test:coverage:merge",
    "test:coverage:merge": "tsx scripts/coverage/merge.ts",
    "data:build": "tsx scripts/data/build.ts",
    "data:translate": "tsx scripts/data/translate.ts",
    "wiki:build": "tsx scripts/wiki/build.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^1.28.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "audit-ci": "^7.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.7",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^8.2.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "js-yaml": "^3.15.1",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.0"
  }
}
